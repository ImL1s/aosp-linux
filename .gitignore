# .gitignore for AOSP Dual-OS Project

# Build & System Artifacts
build_out/
*.o
*.so
*.a
*.class
*.dex
*.apk

# IDE & OS Files
.DS_Store
.vscode/
.idea/
*.swp
*~

# Temporary Logs & Cache
*.log
.agents/*/scratch/
target/
guest/bridge-agent/target/
guest/portal-agent/target/
*.tar.gz
__pycache__/
.pytest_cache/

# Prebuilt Release Archives & Dist
release_dist/
release_dist/*.tar.gz

# C++ & Native Test Binaries
*_bin
*_test
tests/unit/*_bin
unit/challenger_*
tests/unit/challenger_r4_stress_harness.py
tests/unit/challenger_r4_concurrency_pty_stress.py

# Generated Test Reports & Artifacts
e2e_report.json
tests/e2e_report.json
tests/e2e/e2e_report.json
*_report.json
scratch/
patches/
